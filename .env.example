# Copy to .env (git-ignored) only if you need to change the defaults.
# `make db` prints the DSN of the local cluster.

RELAY_ENV=dev
RELAY_LOG_LEVEL=INFO

# Default points at the cluster started by `make db` (unix socket, no TCP port).
RELAY_DATABASE_URL=postgresql://postgres@/postgres?host=/tmp/relay-pgdata

# In CI/production this is a TCP DSN instead, e.g.
# postgresql://relay:secret@db.internal:5432/relay?sslmode=require

RELAY_DB_POOL_MIN_SIZE=1
RELAY_DB_POOL_MAX_SIZE=10
